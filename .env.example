# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string, e.g.:
# mongodb+srv://<username>:<password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string_here

# Name of the database inside your Atlas cluster
MONGO_DB_NAME=movie_recommender
